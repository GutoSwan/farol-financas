# Configuração do frontend Vue (Vite).
# Use a URL e a PUBLISHABLE KEY do Supabase: Project Connect > Framework > Vue.
# NÃO inclua a service_role ou sb_secret_... aqui.
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_SUBSTITUA_PELA_CHAVE_PUBLICA"

# Opcional: somente depois de publicar a API e aplicar as migrações no Supabase.
# É um endereço HTTPS público, nunca uma chave ou URL de banco.
# Ex.: https://SEU-PROJETO-API.vercel.app
# VITE_API_BASE_URL=""
