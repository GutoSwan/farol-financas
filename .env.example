# Frontend Vite. Em Vercel, configure estas variáveis no projeto
# "farol-financas" em Settings > Environment Variables > Preview.
# Variáveis VITE_* são incorporadas no bundle público; NUNCA coloque senhas
# PostgreSQL, service_role, sb_secret_ ou tokens privados aqui.
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_SUBSTITUA_PELA_CHAVE_PUBLICA"

# URL HTTPS do deployment Preview do PROJETO farol-api, sem caminho /api.
VITE_API_BASE_URL="https://SEU-BACKEND-PREVIEW.vercel.app"

# Etapa inicial: só leitura na interface de espaços online.
# Não habilitar escrita enquanto o Preview usar banco de produção.
VITE_ENABLE_ONLINE_WORKSPACE_WRITES="false"
