# Copie para backend/.env e NÃO compartilhe credenciais reais
PORT=3333
HOST=127.0.0.1
DATABASE_URL="postgresql://farol:farol_local_dev@localhost:5433/farol?schema=public"
# URL do seu projeto Supabase (ex.: https://abcxyz.supabase.co)
SUPABASE_URL="https://seu-projeto.supabase.co"

# Na Vercel, defina CORS_ORIGIN com o domínio exato e estável do frontend HTTPS.
# Em desenvolvimento, use http://localhost:5173.
CORS_ORIGIN="http://localhost:5173"

# Na Vercel/Functions, DATABASE_URL deve ser a URL do Transaction pooler
# do Supabase (porta 6543), com ?pgbouncer=true&connection_limit=1.
# Para executar prisma migrate deploy, use temporariamente a URL de
# Session pooler (porta 5432) no terminal, não a URL de transações.
