{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/contas-mensais",
      "destination": "/index.html"
    },
    {
      "source": "/gastos-fixos",
      "destination": "/index.html"
    },
    {
      "source": "/lancamentos",
      "destination": "/index.html"
    },
    {
      "source": "/cartoes",
      "destination": "/index.html"
    },
    {
      "source": "/orcamentos",
      "destination": "/index.html"
    },
    {
      "source": "/presentes",
      "destination": "/index.html"
    },
    {
      "source": "/relatorios",
      "destination": "/index.html"
    },
    {
      "source": "/relatorios/detalhes",
      "destination": "/index.html"
    },
    {
      "source": "/entrar",
      "destination": "/index.html"
    },
    {
      "source": "/cadastro",
      "destination": "/index.html"
    },
    {
      "source": "/recuperar-senha",
      "destination": "/index.html"
    },
    {
      "source": "/redefinir-senha",
      "destination": "/index.html"
    },
    {
      "source": "/conta",
      "destination": "/index.html"
    },
    {
      "source": "/verificar-2fa",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
